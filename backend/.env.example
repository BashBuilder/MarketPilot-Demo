# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored; never commit secrets here.

# Required — startup fails with a validation error if any of these is missing.
# Obtain a key from https://platform.deepseek.com/.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Local stack from docker-compose.yml (postgres service).
# In production use the managed Postgres URL; append ?ssl=require when connecting
# over an external endpoint (Render's internal URL needs no SSL).
DATABASE_URL=postgresql+asyncpg://marketpilot:marketpilot@localhost:5432/marketpilot
# Local stack from docker-compose.yml (redis service).
REDIS_URL=redis://localhost:6379/0
# Redis event streams: cap each run stream and expire it after a terminal event.
EVENT_STREAM_MAXLEN=2000
EVENT_STREAM_TTL_SECONDS=86400
# Resume runs left running by a previous process when the app starts.
RESUME_ON_STARTUP=true
# fake | hosted | huggingface
# hosted requires IMAGE_API_URL + IMAGE_API_KEY.
# huggingface uses HUGGINGFACEHUB_API_TOKEN and calls HF Inference Providers; no local weights.
IMAGE_PROVIDER=fake
IMAGE_API_URL=
IMAGE_API_KEY=
IMAGE_MODEL_ID=stabilityai/sdxl-turbo
# Total per-image deadline; enforced by the hosted and huggingface providers.
IMAGE_TIMEOUT_SECONDS=45
# Only "fake" is implemented today; keep the default.
SEARCH_PROVIDER=fake
# Where generated assets live once published. "local" keeps files next to the
# app (development only: container disks are ephemeral). "cloudinary" uploads
# each asset and stores its public HTTPS URL in the campaign package.
ASSET_STORAGE=local
ASSET_DIR=assets
# Required when ASSET_STORAGE=cloudinary. Secrets stay server-side.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=marketpilot
CLOUDINARY_TIMEOUT_SECONDS=30
# fake | huggingface (huggingface requires: uv sync --extra embeddings)
EMBEDDER=fake
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Used by EMBEDDER=huggingface, IMAGE_PROVIDER=huggingface and the benchmark.
HUGGINGFACEHUB_API_TOKEN=
COST_CAP_PER_RUN=2.0
MAX_IMAGE_CALLS_PER_RUN=8

# New images generated per run; later prompts from the direction are skipped.
MAX_GENERATED_IMAGES_PER_RUN=1
MAX_SEARCH_CALLS_PER_RUN=20
# Longest prompt the Designer may send to an image provider.
MAX_IMAGE_PROMPT_LENGTH=1000
RETRY_MAX_ATTEMPTS=3
# Reviewer scoring gate: below this total the package reruns the weakest node.
SCORE_THRESHOLD=70
# Maximum automatic low-score loops before escalating to the human.
MAX_AUTO_LOOPS=2
# Input limits and rate limits (writes per client IP per minute).
MAX_IDEA_LENGTH=2000
MAX_COMMENT_LENGTH=2000
RATE_LIMIT_PER_MINUTE=20
MAX_CONCURRENT_RUNS=3
# Set true only behind a proxy that sets X-Forwarded-For (Render does).
TRUST_PROXY=false
# Comma-separated allowlist of frontend origins; no wildcard.
FRONTEND_ORIGIN=http://localhost:3000,https://marketpilot-demo-frontend.vercel.app
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
