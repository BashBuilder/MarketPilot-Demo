# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored; never commit secrets here.

# Required — startup fails with a validation error if any of these is missing.
# Obtain a key from https://platform.deepseek.com/.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Local stack from docker-compose.yml (postgres service).
DATABASE_URL=postgresql+asyncpg://marketpilot:marketpilot@localhost:5432/marketpilot
# Local stack from docker-compose.yml (redis service).
REDIS_URL=redis://localhost:6379/0
# fake | flux | sdxl
IMAGE_PROVIDER=fake
COST_CAP_PER_RUN=2.0
MAX_IMAGE_CALLS_PER_RUN=8
MAX_SEARCH_CALLS_PER_RUN=20
RETRY_MAX_ATTEMPTS=3
# Reviewer scoring gate: below this total the package reruns the weakest node.
SCORE_THRESHOLD=70
# Maximum automatic low-score loops before escalating to the human.
MAX_AUTO_LOOPS=2
FRONTEND_ORIGIN=http://localhost:3000
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
