{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["backend/agent.md", "frontend/agent.md"],
  "watcher": {
    "ignore": [
      "node_modules/**",
      "**/node_modules/**",
      ".venv/**",
      "**/.venv/**",
      "**/__pycache__/**",
      "**/.pytest_cache/**",
      "**/.mypy_cache/**",
      "**/.ruff_cache/**",
      "**/.next/**",
      "**/dist/**",
      "**/build/**",
      "**/coverage/**",
      "**/playwright-report/**",
      "**/test-results/**",
      "**/generated_assets/**",
      ".git/**"
    ]
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "*node_modules/*": "deny",
      "*.venv/*": "deny",
      "*__pycache__/*": "deny",
      "*.pytest_cache/*": "deny",
      "*.mypy_cache/*": "deny",
      "*.ruff_cache/*": "deny",
      "*.next/*": "deny",
      "*dist/*": "deny",
      "*build/*": "deny",
      "*coverage/*": "deny",
      "*playwright-report/*": "deny",
      "*test-results/*": "deny",
      "*generated_assets/*": "deny",
      "*pnpm-lock.yaml": "deny",
      "*package-lock.json": "deny",
      "*uv.lock": "deny",
      "*.png": "deny",
      "*.jpg": "deny",
      "*.jpeg": "deny",
      "*.webp": "deny",
      "*.mp4": "deny",
      "*.safetensors": "deny"
    },
    "bash": {
      "*": "allow",
      "*node_modules*": "deny",
      "*pnpm-lock.yaml*": "deny",
      "*uv.lock*": "deny"
    }
  }
}
