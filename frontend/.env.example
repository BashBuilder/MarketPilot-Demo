# Frontend configuration — copy to .env.local and adjust as needed.
# Only NEXT_PUBLIC_* variables reach the browser; never put secrets here.

# Base URL of the backend API (contract section 2 in agent.md).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Server-side directory containing backend-generated images. Used by the
# same-origin /api/assets proxy because the backend returns relative URIs.
# Point this at the backend's ASSET_DIR (or a shared volume in Docker).
# BACKEND_ASSET_DIR=../MarketPilot-Backend/backend/assets

# Enable the MSW mock API. `pnpm dev:mock` sets this automatically.
# NEXT_PUBLIC_API_MOCKING=enabled
