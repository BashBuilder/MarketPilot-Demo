# Placeholders only — copy to .env and fill in real values.
# Required in every environment:
DEEPSEEK_API_KEY=
DATABASE_URL=
REDIS_URL=
# The deployed frontend origin; CORS rejects everything else.
FRONTEND_ORIGIN=

DEEPSEEK_BASE_URL=https://api.deepseek.com
IMAGE_PROVIDER=fake
IMAGE_API_URL=
IMAGE_API_KEY=
IMAGE_MODEL_ID=stabilityai/sdxl-turbo
IMAGE_TIMEOUT_SECONDS=45
MAX_IMAGE_PROMPT_LENGTH=1000
SEARCH_PROVIDER=fake
EMBEDDER=fake
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HUGGINGFACEHUB_API_TOKEN=

# Generated assets: "local" for development, "cloudinary" in production.
ASSET_STORAGE=local
ASSET_DIR=./assets
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=marketpilot
CLOUDINARY_TIMEOUT_SECONDS=30

COST_CAP_PER_RUN=2.0
MAX_IMAGE_CALLS_PER_RUN=8
MAX_GENERATED_IMAGES_PER_RUN=1
MAX_SEARCH_CALLS_PER_RUN=20
RETRY_MAX_ATTEMPTS=3
SCORE_THRESHOLD=70
MAX_AUTO_LOOPS=2
MAX_IDEA_LENGTH=2000
MAX_COMMENT_LENGTH=2000

EVENT_STREAM_MAXLEN=2000
EVENT_STREAM_TTL_SECONDS=86400
RESUME_ON_STARTUP=true
RATE_LIMIT_PER_MINUTE=20
MAX_CONCURRENT_RUNS=3
TRUST_PROXY=false
LOG_LEVEL=INFO
